{
  "name": "browsercrew",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @browsercrew/extension",
    "build": "npm run build -w @browsercrew/extension",
    "typecheck": "npm run typecheck -w @browsercrew/extension",
    "test": "npm run test --workspaces --if-present",
    "validate:mvp": "node scripts/validate-mvp.mjs",
    "smoke:e2e": "node scripts/e2e-smoke.mjs"
  }
}
