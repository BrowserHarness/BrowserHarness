{
  "schema_version": 1,
  "status": "v0.2-source-audited-browser-reliability",
  "capability_domains": [
    {
      "id": "browser-harness",
      "owner": "BrowserCrew/browsercrew",
      "runtime_contract": {
        "task_sessions": "one browser task = one session",
        "starting_tab": "borrowed user tab",
        "created_tabs": "owned by task session and grouped",
        "unrelated_tab_access": "blocked by default",
        "semantic_targets": "stable @e refs plus compact accessibility snapshot",
        "tab_discovery": [
          "list_tabs",
          "find_tab"
        ],
        "text_entry": [
          "native value setter for framework-controlled form controls",
          "beforeinput/input/change event sequence",
          "contenteditable insertion fallback"
        ],
        "cdp_strategy": "separate Advanced/Bridge distribution; not core optional permission",
        "session_storage": "serialized read-modify-write mutations",
        "navigation": "bounded usable-document wait with final redirected URL",
        "page_reading": {
          "tool": "read_page",
          "default_max_chars": 12000,
          "bounded_by": [
            "chars",
            "screens",
            "time"
          ],
          "continuation": "next_start",
          "signals": [
            "stalled",
            "endless_feed",
            "budget_exhausted",
            "shadow_hosts"
          ],
          "frames": "separate #fN frame reads",
          "scroll_restoration": true
        },
        "foreground_policy": {
          "new_task_tabs": "background by default",
          "find_tab": "changes BrowserCrew task target without Chrome foreground activation",
          "switch_tab": "explicit foreground activation",
          "screenshot": "fails with SCREENSHOT_REQUIRES_VISIBLE_TAB rather than capture a different foreground tab"
        },
        "recorder_v2": {
          "enriched_locators": true,
          "text_input_debouncing": true,
          "key_steps": [
            "Enter",
            "Tab"
          ],
          "inferred_inputs": true,
          "reinjection_safe": true,
          "resilient_locator_matching": true,
          "cross_page_recording": "next milestone"
        },
        "reference_audit": "docs/research/KIMI-EXTENSION-REFERENCE-AUDIT.md"
      }
    },
    {
      "id": "model-routing",
      "owner": "BrowserCrew/browsercrew + BrowserCrew/Automation",
      "runtime_contract": {
        "model_capabilities": [
          "chat",
          "agent",
          "vision",
          "embedding",
          "reranker",
          "audio",
          "image",
          "unknown"
        ],
        "active_roles": [
          "chat",
          "agent"
        ],
        "saved_connections": "multiple",
        "routing": "one primary + at most one fallback",
        "fallback_on": [
          "429",
          "5xx",
          "timeout",
          "empty-response",
          "agent-format-failure"
        ],
        "no_silent_fallback_on": [
          "401",
          "403",
          "authorization/permission failure"
        ],
        "validation": [
          "chat health probe",
          "structured agent health probe"
        ]
      }
    },
    {
      "id": "local-bridge",
      "owner": "BrowserCrew/browsercrew",
      "runtime_contract": {
        "transport": "loopback HTTP + WebSocket",
        "default_address": "127.0.0.1:10087",
        "authentication": "pairing token",
        "protocol_version": "0.1",
        "session_mapping": "external session id = BrowserCrew task session id",
        "safety": "BrowserCrew approval metadata enforced before bridge click/Enter",
        "operations": [
          "start",
          "status",
          "stop",
          "restart",
          "logs",
          "pair"
        ],
        "cdp": "separate Advanced/Bridge distribution"
      }
    },
    {
      "id": "skills",
      "owner": "BrowserCrew/Skills-"
    },
    {
      "id": "workflows-watch-learn",
      "owner": "BrowserCrew/Workflows + BrowserCrew/browsercrew"
    },
    {
      "id": "agents-teams",
      "owner": "BrowserCrew/Agent-Registry + BrowserCrew/browsercrew"
    },
    {
      "id": "memory",
      "owner": "BrowserCrew/browsercrew"
    },
    {
      "id": "mcp-integrations",
      "owner": "BrowserCrew/browsercrew + BrowserCrew/Automation"
    },
    {
      "id": "security-permissions",
      "owner": "BrowserCrew/Security-Trust + BrowserCrew/browsercrew"
    }
  ]
}
