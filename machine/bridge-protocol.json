{
  "schema_version": 1,
  "protocol_version": "0.1",
  "transport": {
    "daemon_http": "http://127.0.0.1:10087",
    "extension_websocket": "ws://127.0.0.1:10087/ws",
    "scope": "loopback-only",
    "authentication": "pairing token"
  },
  "endpoints": {
    "status": {
      "method": "GET",
      "path": "/status",
      "auth": "none"
    },
    "command": {
      "method": "POST",
      "path": "/command",
      "auth": "Bearer pairing-token",
      "request": {
        "session": "stable task/session id",
        "title": "optional human-readable task label",
        "action": "BrowserCrew tool id",
        "args": "tool arguments object"
      },
      "response": {
        "success": {
          "ok": true,
          "data": "tool result"
        },
        "failure": {
          "ok": false,
          "error": {
            "code": "string",
            "message": "string",
            "details": "optional"
          }
        }
      }
    }
  },
  "websocket": {
    "extension_hello": {
      "type": "hello",
      "protocol_version": "0.1",
      "extension_id": "Chrome extension id",
      "extension_version": "manifest version"
    },
    "daemon_ack": {
      "type": "hello_ack",
      "protocol_version": "0.1"
    },
    "command": {
      "type": "command",
      "id": "UUID",
      "protocol_version": "0.1",
      "session": "task id",
      "title": "task label",
      "action": "tool id",
      "args": "object"
    },
    "result": {
      "type": "result",
      "id": "same command UUID",
      "ok": "boolean",
      "data": "success payload",
      "error": "failure payload"
    },
    "keepalive": [
      "heartbeat",
      "heartbeat_ack"
    ]
  },
  "safety": {
    "task_sessions": "bridge session maps directly to BrowserCrew task session",
    "borrowed_tabs": "not owned and cannot be closed by session cleanup",
    "approval": "risky click or Enter returns APPROVAL_REQUIRED",
    "unknown_actions": "rejected by extension allowlist",
    "raw_cdp": "available through authenticated local Bridge"
  },
  "tools": [
    "observe_page",
    "read_page",
    "ax_snapshot",
    "evaluate",
    "site_skill",
    "select_option",
    "hover",
    "find",
    "navigate",
    "click",
    "trusted_click",
    "type",
    "trusted_type",
    "press_key",
    "trusted_key",
    "scroll",
    "wait",
    "open_tab",
    "find_tab",
    "list_tabs",
    "switch_tab",
    "close_tab",
    "screenshot",
    "dialog",
    "network",
    "upload",
    "save_pdf",
    "cdp"
  ],
  "read_page": {
    "purpose": "bounded full-page/document extraction without expanding observe_page",
    "defaults": {
      "max_chars": 12000,
      "max_screens": 40,
      "budget_ms": 15000
    },
    "continuation": "use next_start when present",
    "frames": "top-frame result may include readable frame_id/#f handles"
  },
  "cdp": {
    "accessibility": "ax_snapshot",
    "trusted_input": [
      "trusted_click",
      "trusted_type",
      "trusted_key"
    ],
    "dialogs": "dialog",
    "raw": "cdp",
    "screenshot": "screenshot",
    "evaluate": "evaluate"
  },
  "network": {
    "tool": "network",
    "actions": [
      "start",
      "list",
      "detail",
      "stop"
    ]
  },
  "files": {
    "upload": "upload",
    "pdf": "save_pdf"
  },
  "find": {
    "purpose": "fresh accessibility-tree search without guessing semantic refs",
    "input": "query?, role?, limit?, tab_id?"
  },
  "evaluate": {
    "purpose": "bounded page-context JavaScript inspection/probing",
    "input": "expression, max_chars?, tab_id?",
    "result_limit_chars": 100000
  },
  "screenshot": {
    "tool": "screenshot",
    "modes": [
      "viewport",
      "full-page",
      "semantic-element"
    ],
    "background_tabs": "supported through CDP Page.captureScreenshot"
  },
  "site_skill": {
    "actions": [
      "create",
      "verify",
      "run",
      "list",
      "get",
      "delete"
    ],
    "create": "fresh AX + bounded form evaluate + optional active network evidence -> persisted candidate-only Site Skill",
    "lifecycle": "candidate only; never auto-promote",
    "persistence": "chrome.storage.local candidate library",
    "verify": "recollect fresh site evidence and persist explicit origin/form/field/submit verification result",
    "run": "fresh verification -> fresh semantic target resolution -> parameterized execution; non-GET/risky submission requires BrowserCrew approval proof"
  },
  "select_option": {
    "purpose": "choose native select options using a fresh semantic ref and page input/change events",
    "input": "element_id, value|string[] values, tab_id?"
  },
  "hover": {
    "purpose": "move the real CDP pointer to a fresh semantic target and verify the intended element enters :hover",
    "input": "element_id, tab_id?",
    "verification": [
      "elementFromPoint target/descendant hit-test before dispatch",
      "target :hover state after Input.dispatchMouseEvent"
    ]
  }
}
